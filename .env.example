# Optional PostgreSQL connection string. When this is empty the storefront runs
# without a database and the admin dashboard stays disabled.
# DATABASE_URL=postgresql://user:password@host:5432/ridebmx?sslmode=require
# Optional custom CA cert (PEM) when the provider needs verify-full.
# DATABASE_CA=

# First-login admin credentials. The admin row is seeded from these on the very
# first database init only, then you can rename the account and change the
# password from the admin dashboard. ADMIN_INITIAL_PASSWORD is required in
# production and falls back to a dev-only value in local development.
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=

# Contact + social defaults. These are seeded into the DB on first init and act
# as the fallback for GET /api/site-settings whenever the database is absent.
# CONTACT_EMAIL=support@ridebmx.com
# STORE_PHONE=+1 (555) 019-2669
# STORE_ADDRESS=1420 Ironline Ave, Austin, TX 78702
# STORE_WHATSAPP=15550192669
# INSTAGRAM_URL=https://instagram.com/ridebmx
# FACEBOOK_URL=
# TIKTOK_URL=
# YOUTUBE_URL=
# STORE_CURRENCY=USD

# Product image storage for the admin dashboard. With both values set, dragged
# and pasted images upload to Cloudinary so they survive redeploys. Without them
# the dashboard still accepts drag-and-drop and writes into public/uploads, which
# works locally but is wiped on every serverless redeploy.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
